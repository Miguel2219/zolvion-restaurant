# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
# The conversation model. It must accept a forced tool call: Sonnet 5.5 and Opus 5.5 don't,
# and every payment question fails on them. Empty: the app picks a Haiku from the API's list.
ANTHROPIC_MODEL=claude-haiku-5-5
# The model that reads receipt images. Empty: the same as ANTHROPIC_MODEL.
ANTHROPIC_PROOF_MODEL=claude-sonnet-5-5

# --- WhatsApp Cloud API ---
# Leave WHATSAPP_TOKEN empty to run in FAKE mode (browser simulator only).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=zolvion-demo

# --- optional ---
RESTAURANT_CONFIG=config/restaurant.json
# PostgreSQL (docs/BUILD-AND-RUN.md). This is the default; the tests use the same
# server with "_test" added to the database name.
DATABASE_URL=postgresql://zolvion:zolvion@localhost:5432/zolvion

# --- Chatwoot (Task D) ---
# CHATWOOT_URL is your Chatwoot: Chatwoot Cloud (https://app.chatwoot.com) or a
# self-hosted one (http://localhost:3000). There is no default.
# CHATWOOT_ACCOUNT_ID is the number in <CHATWOOT_URL>/app/accounts/<id>/...
# The Agent Bot's webhook is <Zolvion's address>/chatwoot/webhook.
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_SECRET=
