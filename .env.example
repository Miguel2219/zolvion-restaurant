# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
# Optional. Leave empty and the app asks the API which models exist and picks one.
ANTHROPIC_MODEL=

# --- WhatsApp Cloud API ---
# Leave WHATSAPP_TOKEN empty to run in FAKE mode (browser simulator only).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=zolvion-demo

# --- optional ---
RESTAURANT_CONFIG=config/restaurant.json
DEMO_DB=demo.sqlite3
